---
// Consulta de disponibilidad: arma el mensaje y abre WhatsApp.
// No guarda ni envía datos a ningún servidor.
import { fleet } from '../data/fleet';
import { site } from '../data/site';
import { clp } from '../lib/format';

interface Props {
  /** slug del auto preseleccionado */
  selected?: string;
}
const { selected } = Astro.props;
---
<form class="consult" data-whatsapp={site.whatsapp} novalidate>
  <div class="consult-grid">
    <div class="field">
      <label for="c-auto">Auto</label>
      <select id="c-auto" name="auto">
        <option value="">Cualquiera disponible</option>
        {
          fleet.map((car) => (
            <option value={`${car.name} ${car.year}`} selected={car.slug === selected}>
              {car.name} · {clp(car.price)}
            </option>
          ))
        }
      </select>
    </div>
    <div class="field">
      <label for="c-retiro">Retiro</label>
      <select id="c-retiro" name="retiro">
        <option>Aeropuerto de Puerto Natales</option>
        <option>Hotel en Puerto Natales</option>
        <option>Otro lugar (lo indico en el chat)</option>
      </select>
    </div>
    <div class="field">
      <label for="c-desde">Desde</label>
      <input id="c-desde" name="desde" type="date" required />
    </div>
    <div class="field">
      <label for="c-hasta">Hasta</label>
      <input id="c-hasta" name="hasta" type="date" required />
    </div>
  </div>
  <button type="submit" class="btn btn-accent btn-lg">Consultar disponibilidad</button>
  <p class="consult-note" aria-live="polite">
    Te respondemos por WhatsApp con el precio final. Sin pago en línea.
  </p>
</form>

<script>
  const DEFAULT_NOTE = 'Te respondemos por WhatsApp con el precio final. Sin pago en línea.';

  function toLocal(iso: string): string {
    const [y, m, d] = iso.split('-');
    return `${d}-${m}-${y}`;
  }

  function todayIso(): string {
    const now = new Date();
    const local = new Date(now.getTime() - now.getTimezoneOffset() * 60000);
    return local.toISOString().slice(0, 10);
  }

  function daysBetween(a: string, b: string): number {
    const ms = Date.parse(`${b}T12:00:00`) - Date.parse(`${a}T12:00:00`);
    return Math.round(ms / 86400000);
  }

  document.querySelectorAll<HTMLFormElement>('form.consult').forEach((form) => {
    const phone = form.dataset.whatsapp ?? '';
    const desde = form.querySelector<HTMLInputElement>('[name="desde"]');
    const hasta = form.querySelector<HTMLInputElement>('[name="hasta"]');
    const auto = form.querySelector<HTMLSelectElement>('[name="auto"]');
    const retiro = form.querySelector<HTMLSelectElement>('[name="retiro"]');
    const note = form.querySelector<HTMLElement>('.consult-note');
    if (!desde || !hasta || !auto || !retiro || !note) return;

    const today = todayIso();
    desde.min = today;
    hasta.min = today;

    const update = () => {
      if (desde.value) hasta.min = desde.value;
      if (desde.value && hasta.value) {
        const days = daysBetween(desde.value, hasta.value);
        note.textContent =
          days > 0
            ? `${days} ${days === 1 ? 'día' : 'días'} de arriendo. Te respondemos por WhatsApp con el precio final.`
            : 'La fecha de devolución debe ser posterior a la de retiro.';
      } else {
        note.textContent = DEFAULT_NOTE;
      }
    };
    desde.addEventListener('change', update);
    hasta.addEventListener('change', update);

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!desde.value || !hasta.value) {
        note.textContent = 'Elige las fechas de retiro y devolución.';
        (desde.value ? hasta : desde).focus();
        return;
      }
      const days = daysBetween(desde.value, hasta.value);
      if (days <= 0) {
        note.textContent = 'La fecha de devolución debe ser posterior a la de retiro.';
        hasta.focus();
        return;
      }
      const lines = [
        'Hola, vengo de patagonesrentacar.cl y quiero consultar disponibilidad.',
        `Auto: ${auto.value || 'cualquiera disponible'}`,
        `Retiro: ${retiro.value}`,
        `Desde: ${toLocal(desde.value)}`,
        `Hasta: ${toLocal(hasta.value)} (${days} ${days === 1 ? 'día' : 'días'})`,
      ];
      const url = `https://wa.me/${phone}?text=${encodeURIComponent(lines.join('\n'))}`;
      window.location.href = url;
    });
  });
</script>
