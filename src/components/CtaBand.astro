---
import Icon from './Icon.astro';
import { waLink } from '../lib/format';

interface Props {
  title?: string;
  message?: string;
}
const { title = 'La ruta te espera.', message } = Astro.props;
---
<section class="section section-band">
  <div class="container cta-band">
    <h2 class="display display-l">{title}</h2>
    <a class="btn btn-accent btn-lg" href={waLink(message)} rel="noopener">
      Consultar por WhatsApp
      <Icon name="arrow" />
    </a>
  </div>
</section>
