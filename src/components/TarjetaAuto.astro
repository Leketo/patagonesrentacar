---
import { Image } from 'astro:assets';
import type { Car } from '../data/fleet';
import { badge } from '../data/fleet';
import { clp, routesForCar, widthsUpTo } from '../lib/format';

interface Props {
  car: Car;
  /** h2 en la página de flota, h3 cuando la tarjeta cuelga de otra sección. */
  nivel?: 'h2' | 'h3';
}
const { car, nivel = 'h3' } = Astro.props;
const Nombre = nivel;
const href = `/flota/${car.slug}/`;
const distintivo = badge(car);
const rutas = routesForCar(car.slug);

// Los anchos del `sizes` de abajo están medidos en el navegador, no estimados.
// La reja cambia de columnas según cuántos autos muestre, así que manda el caso
// más ancho, que es la flota y la portada (cinco autos, tres columnas):
//   390 px -> 329   |  800 px -> 340   |  1200 px -> 343   |  1440 px -> 387
// Desde 1312 px el contenedor topa en su ancho máximo (1200 + 2 × 56 de margen)
// y la tarjeta se queda fija en 388 px. Decir 280 px, como decía antes, hacía
// que el navegador bajara la foto de 420 px para una caja de 387: borrosa en
// cuanto la pantalla tenía más de un píxel por punto.
---
<article class="auto">
  <div class="auto__marco">
    <Image
      src={car.photo}
      alt={car.photoAlt}
      widths={widthsUpTo(car.photo.width, [420, 760])}
      sizes="(min-width: 1312px) 388px, (min-width: 1000px) 29vw, (min-width: 700px) 43vw, 87vw"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="auto__cuerpo">
    <p class="auto__precio">
      <span class="auto__cifra">{clp(car.price)}</span>
      <span class="auto__unidad">por día</span>
    </p>

    <Nombre class="auto__nombre">
      <a href={href}>{car.name} {car.year}</a>
    </Nombre>

    <p class="auto__datos">{car.type} · {car.seats} pasajeros · {car.transmission}</p>

    {distintivo && <span class="distintivo">{distintivo}</span>}

    {
      rutas.length > 0 && (
        <p class="auto__ruta">
          Lo recomendamos para
          <strong>{rutas.map((r) => r.name).join(' · ')}</strong>
        </p>
      )
    }

    <!-- El nombre del auto va en el enlace para quien navega con lector de
         pantalla saltando de enlace en enlace: varios "Ver ficha y consultar"
         idénticos no se distinguen entre sí. -->
    <a class="boton boton--linea" href={href}>
      Ver ficha y consultar
      <span class="solo-lectores">el {car.name} {car.year}</span>
    </a>
  </div>
</article>
