---
import Icon from './Icon.astro';
import { waLink } from '../lib/format';

const links = [
  { href: '/flota/', label: 'Flota' },
  { href: '/torres-del-paine/', label: 'Torres del Paine' },
  { href: '/condiciones/', label: 'Condiciones' },
  { href: '/contacto/', label: 'Contacto' },
];

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">Patagones <span>Rent a Car</span></a>
    <nav class="nav" aria-label="Principal">
      {
        links.map((link) => (
          <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn-outline" href={waLink()} rel="noopener">
      <Icon name="whatsapp" size={18} />
      WhatsApp
    </a>
  </div>
</header>
