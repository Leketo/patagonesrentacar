---
import Icon from './Icon.astro';
import { waLink } from '../lib/format';

const links = [
  { href: '/flota/', label: 'Flota' },
  { href: '/torres-del-paine/', label: 'Torres del Paine' },
  { href: '/condiciones/', label: 'Condiciones' },
  { href: '/contacto/', label: 'Contacto' },
];

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Patagones Rent a Car, inicio"><svg class="brand-mark" aria-hidden="true" viewBox="0 0 48 42"><path d="M2 39 12 13 18 30 26 3 33 28 39 15 47 39" fill="none" stroke="currentColor" stroke-width="3"/><path d="m26 3 7 25" stroke="#F08A3C" stroke-width="4"/></svg><span class="brand-name">Patagones <span>Rent a Car · Chile</span></span></a>
    <nav class="nav" aria-label="Principal">
      {
        links.map((link) => (
          <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn-outline" href={waLink()} rel="noopener">
      <Icon name="whatsapp" size={18} />
      WhatsApp
    </a>
  </div>
</header>
