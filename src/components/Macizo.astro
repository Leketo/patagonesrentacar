---
// El macizo del Paine al amanecer. Ilustración, no foto: se ve que es un
// dibujo, y por eso es honesta. No hay ninguna foto real del parque, y una de
// stock estaría prohibida.
//
// Se respeta la forma del macizo como se ve desde el lago Pehoé: el Paine
// Grande ancho y nevado a la izquierda, los Cuernos al centro con su cúpula de
// roca oscura sobre el granito claro, y las tres Torres a la derecha, agujas
// finas que salen de un hombro de roca.
//
// La luz del amanecer cae solo sobre las caras que miran al este, que es lo que
// de verdad pasa en el parque durante unos veinte minutos: por eso el naranja
// de la marca es "amanecer en las torres" y no un color de relleno. Las caras
// iluminadas comparten vértice con la silueta, así que la luz nunca se despega
// de la roca, y se apaga hacia abajo con un degradado: el sol pega primero en
// las cumbres.
//
// El encuadre se ancla abajo (xMidYMax). Así, cuando la pantalla es ancha y la
// franja queda baja, lo que se recorta es cielo y nunca el macizo.

interface Props {
  /** id único: los degradados no pueden chocar si la ilustración se repite. */
  id?: string;
  class?: string;
}
const { id = 'macizo', class: clase } = Astro.props;
const cielo = `${id}-cielo`;
const luz = `${id}-luz`;
const alba = `${id}-alba`;
---

<svg
  class:list={['macizo', clase]}
  viewBox="0 0 1200 420"
  preserveAspectRatio="xMidYMax slice"
  role="img"
  aria-label="Ilustración del macizo del Paine al amanecer: el Paine Grande nevado, los Cuernos y las tres Torres, con la luz del amanecer en sus caras este."
>
  <defs>
    <linearGradient id={cielo} x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0" stop-color="#0a141a" />
      <stop offset="0.5" stop-color="#132530" />
      <stop offset="0.85" stop-color="#28414f" />
      <stop offset="1" stop-color="#3f5260" />
    </linearGradient>

    <!-- La luz se apaga hacia abajo: el sol da primero en las cumbres. -->
    <linearGradient id={luz} gradientUnits="userSpaceOnUse" x1="0" y1="130" x2="0" y2="300">
      <stop offset="0" stop-color="#ffb272" />
      <stop offset="0.35" stop-color="#f08a3c" />
      <!-- Se apaga en transparente y no en un marrón: si no, las caras bajas
           quedan color tierra y la luz parece pintura. -->
      <stop offset="1" stop-color="#f08a3c" stop-opacity="0" />
    </linearGradient>

    <!-- El resplandor del amanecer, pegado al horizonte detrás de las Torres. -->
    <radialGradient id={alba} gradientUnits="userSpaceOnUse" cx="883" cy="268" r="215">
      <stop offset="0" stop-color="#f6a460" stop-opacity="0.22" />
      <stop offset="1" stop-color="#f6a460" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="1200" height="420" fill={`url(#${cielo})`} />
  <rect width="1200" height="420" fill={`url(#${alba})`} />

  <!-- Aquí iban dos nubes lenticulares. Se quitaron: a este tamaño leían como
       platillos grises delante del macizo. La ilustración se juega en la
       silueta y en la luz, y todo lo demás estorba. -->

  <!-- Cordón lejano, detrás del macizo -->
  <polygon
    fill="#1a2c37"
    points="0,420 0,352 120,328 240,344 360,320 480,338 600,312 720,332 840,308 960,330 1080,316 1200,336 1200,420"
  />

  <!-- El macizo, una sola silueta continua -->
  <polygon
    fill="#2c4555"
    points="0,420 0,382 76,370 150,350 222,318
            252,252 278,196 302,158 328,142 358,141 384,162
            406,206 430,264 452,300
            470,296 492,266 514,224 530,196 548,230 562,270
            578,292
            596,262 616,206 638,152 662,202 682,258 698,288
            714,256 730,224 748,260
            768,296 792,312 816,304
            836,290 844,286 852,206 861,286
            867,292 873,286 883,172 893,286
            899,292 905,286 913,214 921,286
            932,296 960,316 1020,336 1090,354 1200,372
            1200,420"
  />

  <!-- Nieve del Paine Grande, en la cara oeste que mira al glaciar Grey. Muy
       tenue: más contraste y parecía otra cumbre en vez de nieve. -->
  <polygon points="328,142 302,158 278,196 300,204 326,160" fill="#d3dee1" opacity="0.14" />

  <!-- Cúpula de roca oscura de los Cuernos: el detalle que los hace Cuernos.
       Es una franja baja y ancha, no un triángulo: así lee como cúpula
       apoyada sobre el granito claro y no como un pico negro aparte. -->
  <g fill="#1b2c36">
    <polygon points="514,224 530,196 548,230 534,238 522,232" />
    <polygon points="616,206 638,152 662,202 642,212 628,210" />
    <polygon points="714,256 730,224 748,260 734,262 722,258" />
  </g>

  <!-- LA LUZ, solo en las caras que miran al este -->
  <g fill={`url(#${luz})`}>
    <!-- Paine Grande: el más lejano al sol, apenas rozado -->
    <polygon points="358,141 384,162 406,206 388,212 364,154" opacity="0.5" />
    <!-- Cuernos: la luz muere donde empieza la falda -->
    <polygon points="530,196 548,230 558,254 546,258 534,214" opacity="0.78" />
    <polygon points="638,152 662,202 676,240 662,245 644,184" opacity="0.78" />
    <polygon points="730,224 748,260 738,263 727,236" opacity="0.78" />
    <!-- Las tres Torres: el amanecer les da de lleno -->
    <polygon points="852,206 861,286 855,286 848,220" />
    <polygon points="883,172 893,286 886,286 878,188" />
    <polygon points="913,214 921,286 915,286 908,226" />
  </g>

  <!-- Primer plano: la pampa, para que el macizo se apoye en algo -->
  <polygon
    fill="#16242d"
    points="0,420 0,398 160,404 340,394 520,402 700,392 880,400 1060,392 1200,398 1200,420"
  />
</svg>

<style>
  .macizo {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
