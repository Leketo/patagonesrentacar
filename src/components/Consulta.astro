---
// Consulta de disponibilidad: arma el mensaje y abre WhatsApp.
// No guarda ni envía datos a ningún servidor, y no usa cookies.
import { fleet } from '../data/fleet';
import { site } from '../data/site';
import { clp, waLink } from '../lib/format';

interface Props {
  /** slug del auto que viene preseleccionado (en la ficha de cada auto). */
  selected?: string;
  /** sobre fondo claro */
  papel?: boolean;
  /** id propio: puede haber dos formularios en la misma página. */
  id?: string;
}
const { selected, papel = false, id = 'consulta' } = Astro.props;
---
<form class:list={['consulta', papel && 'consulta--papel']} data-wasap={site.whatsapp} novalidate>
  <div class="consulta__reja">
    <div class="campo">
      <label for={`${id}-auto`}>Auto</label>
      <select id={`${id}-auto`} name="auto">
        <option value="">El que esté disponible</option>
        {
          fleet.map((car) => (
            <option
              value={`${car.name} ${car.year}`}
              data-precio={clp(car.price)}
              selected={car.slug === selected}
            >
              {car.name} {car.year} — {clp(car.price)}
            </option>
          ))
        }
      </select>
    </div>

    <div class="campo">
      <label for={`${id}-retiro`}>Dónde lo retiras</label>
      <select id={`${id}-retiro`} name="retiro">
        <option>Aeropuerto de Puerto Natales</option>
        <option>Mi hotel en Puerto Natales</option>
        <option>Otro lugar, lo coordinamos por chat</option>
      </select>
    </div>

    <div class="campo">
      <label for={`${id}-desde`}>Lo retiras el</label>
      <input
        id={`${id}-desde`}
        name="desde"
        type="date"
        required
        aria-describedby={`${id}-aviso`}
      />
    </div>

    <div class="campo">
      <label for={`${id}-hasta`}>Lo devuelves el</label>
      <input
        id={`${id}-hasta`}
        name="hasta"
        type="date"
        required
        aria-describedby={`${id}-aviso`}
      />
    </div>
  </div>

  <!-- El aviso va ANTES del botón: si va debajo, en el teléfono el error
       aparece fuera de pantalla justo cuando se pulsa. Y los dos campos de
       fecha lo declaran con aria-describedby, así que quien vuelve al campo
       con un lector de pantalla no solo oye "no válido": oye por qué. -->
  <p id={`${id}-aviso`} class="consulta__aviso" role="status">
    Te respondemos con la disponibilidad y el precio final. No se paga nada en línea.
  </p>

  <button type="submit" class="boton boton--luz boton--grande">Consultar por WhatsApp</button>

  <noscript>
    <p class="consulta__aviso">
      Para armar el mensaje con tus fechas hace falta JavaScript.
      <a class="enlace" href={waLink()} rel="noopener">Escríbenos directo por WhatsApp</a>
      y lo vemos por chat.
    </p>
  </noscript>
</form>

<script>
  const AVISO = 'Te respondemos con la disponibilidad y el precio final. No se paga nada en línea.';

  function aLocal(iso: string): string {
    const [a, m, d] = iso.split('-');
    return `${d}-${m}-${a}`;
  }

  /**
   * Día calendario de una fecha ISO, contado desde 1970, o NaN si la cadena
   * no es una fecha que exista de verdad. El viaje de ida y vuelta por
   * Date.UTC caza el 31 de abril y el 30 de febrero, que Date.parse acepta
   * corriéndolos al mes siguiente. Se cuenta en UTC: así el resultado no
   * depende del cambio de hora de Chile.
   */
  function dia(iso: string): number {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(iso)) return NaN;
    const [a, m, d] = iso.split('-').map(Number);
    const t = Date.UTC(a, m - 1, d);
    const f = new Date(t);
    if (f.getUTCFullYear() !== a || f.getUTCMonth() !== m - 1 || f.getUTCDate() !== d) {
      return NaN;
    }
    return t / 86400000;
  }

  /** La fecha de hoy en la zona horaria del visitante, en formato ISO. */
  function hoyIso(): string {
    const ahora = new Date();
    const local = new Date(ahora.getTime() - ahora.getTimezoneOffset() * 60000);
    return local.toISOString().slice(0, 10);
  }

  function deDia(n: number): string {
    return new Date(n * 86400000).toISOString().slice(0, 10);
  }

  function masDias(iso: string, dias: number): string {
    const n = dia(iso);
    return Number.isFinite(n) ? deDia(n + dias) : '';
  }

  document.querySelectorAll<HTMLFormElement>('form.consulta').forEach((form) => {
    const fono = form.dataset.wasap ?? '';
    const desde = form.querySelector<HTMLInputElement>('[name="desde"]');
    const hasta = form.querySelector<HTMLInputElement>('[name="hasta"]');
    const auto = form.querySelector<HTMLSelectElement>('[name="auto"]');
    const retiro = form.querySelector<HTMLSelectElement>('[name="retiro"]');
    const aviso = form.querySelector<HTMLElement>('.consulta__aviso');
    if (!desde || !hasta || !auto || !retiro || !aviso) return;

    // "Hoy" se recalcula cada vez que se mira el formulario, no una sola vez al
    // cargar: quien deja la pestaña abierta de un día para otro no puede
    // terminar pidiendo una fecha que ya pasó.
    let hoy = dia(hoyIso());
    let tope = hoy + 365;

    function actualizarTopes() {
      hoy = dia(hoyIso());
      tope = hoy + 365;
      desde!.min = deDia(hoy);
      desde!.max = deDia(tope);
      hasta!.min = desde!.value && dia(desde!.value) >= hoy
        ? masDias(desde!.value, 1)
        : deDia(hoy);
      hasta!.max = deDia(tope);
    }

    actualizarTopes();

    // Un error de envío interrumpe (role="alert"); el conteo de días espera su
    // turno (role="status"). El rol se cambia con la región vacía, para que el
    // lector de pantalla lo tome antes de encontrar el texto nuevo.
    function decir(texto: string, esError = false) {
      const rol = esError ? 'alert' : 'status';
      if (aviso!.getAttribute('role') !== rol) {
        aviso!.textContent = '';
        aviso!.setAttribute('role', rol);
      }
      aviso!.textContent = texto;
      aviso!.classList.toggle('consulta__aviso--error', esError);
    }

    function marcar(campo: HTMLElement | null) {
      [desde, hasta].forEach((c) => c?.removeAttribute('aria-invalid'));
      if (campo) {
        campo.setAttribute('aria-invalid', 'true');
        campo.focus();
      }
    }

    // Al elegir el retiro, la devolución no puede ser antes. Y si todavía no
    // hay devolución, se propone el día siguiente: un clic menos.
    function alCambiarDesde() {
      actualizarTopes();
      const siguiente = masDias(desde!.value, 1);
      if (siguiente && (!hasta!.value || hasta!.value <= desde!.value)) {
        hasta!.value = siguiente;
      }
      repasar();
    }

    /**
     * Un solo lugar donde se decide si las fechas sirven. Devuelve el campo que
     * falla y qué decirle a quien lo escribió, o los días de arriendo si todo
     * está bien. Lo usan por igual el repaso en vivo y el envío, así que no
     * pueden opinar distinto.
     *
     * `falta` separa "todavía no lo llenaste" de "lo llenaste mal": lo primero
     * no es un error mientras se escribe, pero sí lo es al enviar.
     */
    function revisar(): { campo?: HTMLInputElement; mensaje?: string; falta?: boolean; n?: number } {
      actualizarTopes();

      if (!desde!.value) {
        return { campo: desde!, mensaje: 'Falta la fecha en que retiras el auto.', falta: true };
      }
      if (!hasta!.value) {
        return { campo: hasta!, mensaje: 'Falta la fecha en que devuelves el auto.', falta: true };
      }

      // Lo primero, antes de contar días: que las dos fechas existan. Si no,
      // la resta daría NaN y el mensaje saldría con "Son NaN días".
      const d0 = dia(desde!.value);
      const d1 = dia(hasta!.value);
      if (!Number.isFinite(d0)) {
        return { campo: desde!, mensaje: 'Revisa la fecha de retiro: no es una fecha válida.' };
      }
      if (!Number.isFinite(d1)) {
        return { campo: hasta!, mensaje: 'Revisa la fecha de devolución: no es una fecha válida.' };
      }

      if (d0 < hoy) {
        return { campo: desde!, mensaje: 'La fecha de retiro no puede estar en el pasado.' };
      }
      if (d0 > tope) {
        return {
          campo: desde!,
          mensaje: 'Tomamos consultas hasta un año adelante. Para más allá, escríbenos por WhatsApp.',
        };
      }
      if (d1 > tope) {
        return {
          campo: hasta!,
          mensaje: 'Tomamos consultas hasta un año adelante. Para más allá, escríbenos por WhatsApp.',
        };
      }

      const n = d1 - d0;
      if (n <= 0) {
        return {
          campo: hasta!,
          mensaje: 'La fecha de devolución tiene que ser posterior a la de retiro.',
        };
      }

      // Red de seguridad: lo que el propio navegador piensa de los campos,
      // con min y max ya puestos al día. Si discrepa con lo de arriba, manda
      // el navegador y no se envía nada.
      for (const campo of [desde!, hasta!]) {
        if (!campo.validity.valid) {
          return { campo, mensaje: 'Revisa las fechas: alguna queda fuera del rango que atendemos.' };
        }
      }

      return { n };
    }

    function repasar() {
      const r = revisar();
      marcar(null);
      if (r.falta) {
        decir(AVISO);
        return;
      }
      if (r.mensaje) {
        decir(r.mensaje, true);
        return;
      }
      const n = r.n!;
      const plural = n === 1 ? 'día' : 'días';
      decir(
        n >= 2
          ? `${n} ${plural} de arriendo. Desde dos días la tarifa se ajusta: te enviamos el precio final por WhatsApp.`
          : `${n} ${plural} de arriendo. Te enviamos el precio final por WhatsApp.`,
      );
    }

    desde.addEventListener('change', alCambiarDesde);
    hasta.addEventListener('change', repasar);
    auto.addEventListener('change', repasar);

    form.addEventListener('submit', (evento) => {
      evento.preventDefault();

      const r = revisar();
      if (r.mensaje) {
        decir(r.mensaje, true);
        marcar(r.campo ?? null);
        return;
      }
      const n = r.n!;

      const elegido = auto.selectedOptions[0];
      const precio = elegido?.dataset.precio;
      const lineas = [
        'Hola, vengo de patagonesrentacar.cl y quiero consultar disponibilidad.',
        '',
        `Auto: ${auto.value ? `${auto.value}${precio ? ` (${precio} por día)` : ''}` : 'el que esté disponible'}`,
        `Retiro: ${retiro.value}`,
        `Fechas: del ${aLocal(desde.value)} al ${aLocal(hasta.value)}`,
        `Son ${n} ${n === 1 ? 'día' : 'días'}.`,
      ];

      window.location.href = `https://wa.me/${fono}?text=${encodeURIComponent(lineas.join('\n'))}`;
    });
  });
</script>
