---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { waLink } from '../lib/format';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p><strong>{site.name}</strong> · {site.city}, {site.region}</p>
      <p>{site.hours} · WhatsApp <a href={waLink()} rel="noopener">{site.phoneDisplay}</a></p>
      {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
      <p>© {year} {site.name}</p>
    </div>
    <nav class="footer-links" aria-label="Legal">
      <a href="/condiciones/">Condiciones</a>
      <a href="/terminos/">Términos</a>
      <a href="/privacidad/">Privacidad</a>
    </nav>
  </div>
</footer>
<a class="wa-float" href={waLink()} rel="noopener" aria-label="Escribir por WhatsApp">
  <Icon name="whatsapp" size={28} />
</a>
