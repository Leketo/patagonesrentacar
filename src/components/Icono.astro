---
// Iconos dibujados aquí mismo: no se carga ningún paquete ni servicio externo.
interface Props {
  name: 'wasap' | 'tilde' | 'fono' | 'reloj' | 'pin';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={name === 'tilde' ? 2.6 : 1.9}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'wasap' && <path d="M20.5 11.6a8.3 8.3 0 0 1-12.2 7.3L3.5 20l1.2-4.7A8.3 8.3 0 1 1 20.5 11.6z" />}
  {name === 'tilde' && <path d="M5 12.6l4.4 4.4L19 7.4" />}
  {name === 'fono' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />}
  {name === 'reloj' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === 'pin' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
</svg>
