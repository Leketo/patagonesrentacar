---
import type { Car } from '../data/fleet';
import { clp } from '../lib/format';

interface Props {
  car: Car;
  headingLevel?: 'h2' | 'h3';
}
const { car, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const href = `/flota/${car.slug}/`;
---
<article class="car-card">
  <a href={href} tabindex="-1" aria-hidden="true">
    <img
      src={car.image}
      alt={car.imageAlt}
      width={car.imageWidth}
      height={car.imageHeight}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="car-body">
    <span class="car-tag">{car.tag}</span>
    <Heading><a href={href}>{car.name} {car.year}</a></Heading>
    <p class="car-specs">{car.type} · {car.seats} pasajeros · {car.transmission}</p>
    <p class="car-price"><strong>{clp(car.price)}</strong><span>por día · IVA incluido</span></p>
    <a class="btn btn-dark" href={href}>Ver auto y consultar <span aria-hidden="true">↗</span></a>
  </div>
</article>
