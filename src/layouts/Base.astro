---
// Solo el subconjunto latino y solo los tres pesos que el sitio usa de verdad:
// Barlow 400 y 600 para texto, y Barlow Condensed 700 para titulares. Cada
// peso son unos 22 KB, así que no se carga ninguno "por si acaso".
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
// La URL con hash del archivo, para precargarlo: el titular es lo primero que
// se ve y lo que suele medir el LCP.
import condensadaWoff2 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import '../styles/global.css';

import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { site } from '../data/site';
import { fleet } from '../data/fleet';
import portada from '../assets/portada/puerto-natales-subaru.jpg';

interface Props {
  title: string;
  description: string;
  /** Imagen para redes. Por defecto, el Subaru en la costanera de Puerto Natales. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /**
   * Declarar la canónica. El 404 la pasa en false: en el servidor se sirve
   * como /404.html para cualquier ruta que no existe, así que la URL que
   * Astro deduce de su ruta de compilación no va a existir en línea.
   */
  canonica?: boolean;
  /** Datos estructurados extra de la página (preguntas, migas, auto). */
  schema?: unknown[];
}

const {
  title,
  description,
  image,
  imageAlt = 'Subaru XV de Patagones Rent a Car en la costanera de Puerto Natales, con la cordillera al fondo',
  noindex = false,
  canonica = true,
  schema = [],
} = Astro.props;

const tituloCompleto = title.includes(site.name) ? title : `${title} | ${site.name}`;
const urlCanonica = new URL(Astro.url.pathname, Astro.site).toString();
const imagenRedes = new URL(image ?? portada.src, Astro.site).toString();

// El negocio. Se declara una vez y se repite en todas las páginas: es el mismo.
const negocio = {
  '@context': 'https://schema.org',
  '@type': 'AutoRental',
  '@id': `${site.url}/#negocio`,
  name: site.name,
  description: `Arriendo de autos en ${site.city}, ${site.region}, Chile, para viajar al Parque Nacional Torres del Paine.`,
  url: site.url,
  telephone: site.phoneDisplay,
  image: new URL(portada.src, Astro.site).toString(),
  slogan: site.slogan,
  openingHours: site.openingHours,
  priceRange: '$$',
  currenciesAccepted: 'CLP',
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'CL',
  },
  areaServed: [
    { '@type': 'City', name: 'Puerto Natales' },
    { '@type': 'Place', name: 'Parque Nacional Torres del Paine' },
  ],
  // Los autos con su precio: el mismo dato que ve el visitante.
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Flota',
    itemListElement: fleet.map((car) => ({
      '@type': 'Offer',
      name: `${car.name} ${car.year}`,
      price: car.price,
      priceCurrency: 'CLP',
      url: `${site.url}/flota/${car.slug}/`,
      availability: 'https://schema.org/InStock',
      itemOffered: {
        '@type': 'Car',
        name: `${car.name} ${car.year}`,
        vehicleTransmission: car.transmission,
        vehicleSeatingCapacity: car.seats,
      },
    })),
  },
};

const datos = [negocio, ...schema];
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    {canonica && <link rel="canonical" href={urlCanonica} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {/* El .ico va primero y el SVG después: el navegador que entiende SVG se
        queda con el segundo, y el que no, con el primero. Los tres los genera
        scripts/generar-iconos.mjs desde el mismo favicon.svg. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0E1A22" />
    <link rel="preload" href={condensadaWoff2} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={imagenRedes} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {datos.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
  </body>
</html>
