---
import Base from '../../layouts/Base.astro';
import Flota from '../../components/Flota.astro';
import Condiciones from '../../components/Condiciones.astro';
import Cierre from '../../components/Cierre.astro';
import { fleet, minPrice } from '../../data/fleet';
import { site } from '../../data/site';
import { clp, conMayuscula, enLetras } from '../../lib/format';

// La lista sale de los datos: si entra un auto, aparece aquí solo.
const nombres = fleet.map((c) => c.name).join(', ');
---
<Base
  title={`Flota: ${enLetras(fleet.length)} autos en Puerto Natales`}
  description={`${nombres}. Desde ${clp(minPrice)} por día con IVA, seguro y kilometraje libre.`}
>
  <div class="contenedor encabezado-pagina">
    <h1 class="titular titular--pagina">
      {conMayuscula(enLetras(fleet.length))} autos listos para la ruta
    </h1>
    <p class="bajada">
      Con seguro y kilometraje libre, y el estanque lleno al retirar. Elige por precio,
      por asientos o por la ruta que vas a hacer.
    </p>
  </div>

  <section class="seccion seccion--pegada" aria-label="Autos disponibles">
    <div class="contenedor">
      <Flota autos={fleet} nivel="h2" />
      <p class="letra-chica tras-bloque">
        Precios por día con IVA incluido. Desde dos días de arriendo la tarifa se ajusta:
        escríbenos con tus fechas y te enviamos el precio final.
      </p>
    </div>
  </section>

  <section class="seccion seccion--granito" aria-labelledby="t-condiciones">
    <div class="contenedor">
      <div class="cabeza-seccion">
        <h2 id="t-condiciones" class="titular titular--seccion">Las mismas condiciones para todos</h2>
      </div>
      <Condiciones />
      <p class="letra-chica tras-bloque">
        <a class="enlace" href="/condiciones/">Requisitos y preguntas frecuentes</a>
      </p>
    </div>
  </section>

  <Cierre
    titulo="¿Cuál te sirve?"
    texto={`Cuéntanos cuántos son y qué ruta harás, y te decimos cuál conviene. ${site.hours}.`}
    mensaje="Hola, vengo de patagonesrentacar.cl y quiero ayuda para elegir el auto."
  />
</Base>
