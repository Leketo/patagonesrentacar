---
import Base from '../../layouts/Base.astro';
import TarjetaAuto from '../../components/TarjetaAuto.astro';
import Condiciones from '../../components/Condiciones.astro';
import Cierre from '../../components/Cierre.astro';
import { fleet, minPrice } from '../../data/fleet';
import { site } from '../../data/site';
import { clp } from '../../lib/format';
---
<Base
  title="Flota: cuatro SUV automáticas"
  description={`Subaru XV, Renault Duster, Suzuki Grand Nomade 4x4 y Kia Sorento de siete asientos. Desde ${clp(minPrice)} por día con IVA, seguro y kilometraje libre.`}
>
  <div class="contenedor encabezado-pagina">
    <h1 class="titular titular--pagina">Cuatro SUV listas para la ruta</h1>
    <p class="bajada">
      Todas automáticas, con seguro y kilometraje libre, y el estanque lleno al retirar.
      Elige por precio, por asientos o por la ruta que vas a hacer.
    </p>
  </div>

  <section class="seccion seccion--pegada" aria-label="Autos disponibles">
    <div class="contenedor">
      <div class="flota">
        {fleet.map((car) => <TarjetaAuto car={car} nivel="h2" />)}
      </div>
      <p class="letra-chica tras-bloque">
        Precios por día con IVA incluido. Desde dos días de arriendo la tarifa se ajusta:
        escríbenos con tus fechas y te enviamos el precio final.
      </p>
    </div>
  </section>

  <section class="seccion seccion--granito" aria-labelledby="t-condiciones">
    <div class="contenedor">
      <div class="cabeza-seccion">
        <h2 id="t-condiciones" class="titular titular--seccion">Las mismas condiciones para los cuatro</h2>
      </div>
      <Condiciones />
      <p class="letra-chica tras-bloque">
        <a class="enlace" href="/condiciones/">Requisitos y preguntas frecuentes</a>
      </p>
    </div>
  </section>

  <Cierre
    titulo="¿Cuál te sirve?"
    texto={`Cuéntanos cuántos son y qué ruta harás, y te decimos cuál conviene. ${site.hours}.`}
    mensaje="Hola, vengo de patagonesrentacar.cl y quiero ayuda para elegir el auto."
  />
</Base>
