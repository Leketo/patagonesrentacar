---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Consulta from '../../components/Consulta.astro';
import Flota from '../../components/Flota.astro';
import Icono from '../../components/Icono.astro';
import Condiciones from '../../components/Condiciones.astro';
import { fleet, badge, type Car } from '../../data/fleet';
import { site, services } from '../../data/site';
import { clp, enLetras, routesForCar, widthsUpTo } from '../../lib/format';

export function getStaticPaths() {
  return fleet.map((car) => ({ params: { slug: car.slug }, props: { car } }));
}

interface Props {
  car: Car;
}
const { car } = Astro.props;
const otros = fleet.filter((c) => c.slug !== car.slug);
const rutas = routesForCar(car.slug);
const distintivo = badge(car);

// Migas de pan y el auto, para los buscadores.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Flota', item: `${site.url}/flota/` },
      {
        '@type': 'ListItem',
        position: 3,
        name: `${car.name} ${car.year}`,
        item: `${site.url}/flota/${car.slug}/`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Car',
    name: `${car.name} ${car.year}`,
    vehicleTransmission: car.transmission,
    vehicleSeatingCapacity: car.seats,
    bodyType: car.type,
    modelDate: car.year,
    offers: {
      '@type': 'Offer',
      price: car.price,
      priceCurrency: 'CLP',
      availability: 'https://schema.org/InStock',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: car.price,
        priceCurrency: 'CLP',
        unitCode: 'DAY',
        valueAddedTaxIncluded: true,
      },
      seller: { '@id': `${site.url}/#negocio` },
    },
  },
];
---
<!-- El título se cierra con " | Patagones Rent a Car", que son 23 caracteres:
     al nombre del auto le quedan 37 para no pasar de 60, que es donde corta
     Google. El más largo de la flota, "Arriendo de Suzuki Grand Nomade 2017",
     mide 36. Si entra un auto con nombre más largo, hay que acortar aquí. -->
<Base
  title={`Arriendo de ${car.name} ${car.year}`}
  description={`${car.name} ${car.year}, ${car.type} de ${car.seats} pasajeros. ${clp(car.price)} por día con IVA, seguro y kilometraje libre. Entrega en el aeropuerto o en tu hotel.`}
  image={car.photo.src}
  imageAlt={car.photoAlt}
  schema={schema}
>
  <section class="seccion">
    <div class="contenedor">
      <!-- Lista de verdad, y los separadores con aria-hidden: si no, el lector
           de pantalla lee "mayor que" entre cada enlace. -->
      <nav class="migas" aria-label="Migas de pan">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/flota/">Flota</a></li>
          <li aria-hidden="true">›</li>
          <li><span aria-current="page">{car.name} {car.year}</span></li>
        </ol>
      </nav>

      <div class="ficha">
        <figure class="ficha__foto">
          <Image
            src={car.photo}
            alt={car.photoAlt}
            widths={widthsUpTo(car.photo.width, [560, 900, 1284])}
            sizes="(min-width: 900px) 55vw, 94vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>

        <div class="ficha__datos">
          <div class="pila">
            <h1 class="titular titular--pagina">{car.name} {car.year}</h1>
            {distintivo && <span class="distintivo">{distintivo}</span>}
            <p class="bajada">{car.bestFor}</p>
          </div>

          <p class="precio-ficha">
            <span class="precio-ficha__cifra">{clp(car.price)}</span>
            <span class="precio-ficha__glosa">
              por día, IVA incluido<br />Desde dos días la tarifa se ajusta
            </span>
          </p>

          <dl class="especificaciones">
            <div><dt>Tipo</dt><dd>{car.type}</dd></div>
            <div><dt>Pasajeros</dt><dd>{car.seats}</dd></div>
            <div><dt>Transmisión</dt><dd>{car.transmission}</dd></div>
            <div><dt>Año</dt><dd>{car.year}</dd></div>
          </dl>

          {
            rutas.length > 0 && (
              <div class="pila">
                <h2 class="titular titular--bloque">Para qué ruta sirve</h2>
                <ul class="tildes">
                  {rutas.map((r) => (
                    <li>
                      <Icono name="tilde" size={20} />
                      <span>
                        <a class="enlace" href={`/torres-del-paine/#${r.slug}`}>{r.name}</a>
                        {' — '}{r.duration.toLowerCase()}. {r.detail}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="seccion seccion--granito" aria-labelledby="t-consulta">
    <div class="contenedor">
      <div class="cabeza-seccion">
        <h2 id="t-consulta" class="titular titular--seccion">Consulta por este auto</h2>
        <p>Ya viene elegido. Pon tus fechas y se abre WhatsApp con el mensaje escrito.</p>
      </div>
      <Consulta selected={car.slug} id={`ficha-${car.slug}`} />
    </div>
  </section>

  <section class="seccion" aria-labelledby="t-incluye">
    <div class="contenedor">
      <div class="cabeza-seccion">
        <h2 id="t-incluye" class="titular titular--seccion">Incluido en el arriendo</h2>
      </div>
      <ul class="tildes">
        {
          services.map((s) => (
            <li>
              <Icono name="tilde" size={20} />
              <span>{s}</span>
            </li>
          ))
        }
      </ul>

      <div class="cabeza-seccion tras-bloque">
        <h3 class="titular titular--bloque">Condiciones</h3>
      </div>
      <Condiciones />
      <p class="letra-chica tras-bloque">
        <a class="enlace" href="/condiciones/">Requisitos y preguntas frecuentes</a>
      </p>
    </div>
  </section>

  <section class="seccion seccion--granito" aria-labelledby="t-otros">
    <div class="contenedor">
      <div class="cabeza-seccion">
        <h2 id="t-otros" class="titular titular--seccion">Los otros {enLetras(otros.length)}</h2>
      </div>
      <Flota autos={otros} />
    </div>
  </section>
</Base>
