---
import Base from '../layouts/Base.astro';
import Condiciones from '../components/Condiciones.astro';
import Cierre from '../components/Cierre.astro';
import Icono from '../components/Icono.astro';
import { site, requirements, services, conditions } from '../data/site';
import { minPrice } from '../data/fleet';
import { clp } from '../lib/format';

const preguntas = [
  {
    q: '¿Qué necesito para arrendar?',
    a: `Cédula de identidad o pasaporte vigente, y licencia de conducir vigente a nombre de quien retira el auto. La edad mínima es de ${site.minAge} años.`,
  },
  {
    q: '¿El precio incluye IVA y seguro?',
    a: `Sí. El precio por día que ves en el sitio ya trae el IVA y el seguro. Los precios parten en ${clp(minPrice)} por día.`,
  },
  {
    q: '¿Hay límite de kilómetros?',
    a: 'No. El kilometraje es libre: recorres la Patagonia sin sorpresas en el costo final.',
  },
  {
    q: '¿Dónde retiro y devuelvo el auto?',
    a: `Te lo entregamos en el aeropuerto de ${site.city} o en tu hotel, y lo devuelves donde acordemos. Todo se coordina por WhatsApp.`,
  },
  {
    q: '¿Cómo cambia el precio si arriendo varios días?',
    a: 'La tarifa se ajusta desde dos días de arriendo. Escríbenos con tus fechas y te enviamos el precio final antes de que decidas.',
  },
  {
    q: '¿Puedo agregar otro conductor?',
    a: 'Sí. Cada conductor adicional debe cumplir los mismos requisitos: licencia vigente, documento de identidad y la edad mínima.',
  },
  {
    q: '¿Qué pasa si tengo un problema en ruta?',
    a: `Tienes asistencia en ruta las 24 horas. La atención para arriendos y consultas es ${site.hours.toLowerCase()}.`,
  },
  {
    q: '¿Puedo cruzar a Argentina con el auto?',
    a: 'Es uno de los datos que todavía no tenemos cerrados. Consúltanos por WhatsApp antes de reservar y te lo confirmamos.',
  },
  {
    q: '¿Se pide depósito en garantía?',
    a: 'Es otro de los datos que todavía no tenemos cerrados. Pregúntanos por WhatsApp antes de reservar y te lo confirmamos.',
  },
  {
    q: '¿Qué debo saber para entrar a Torres del Paine?',
    a: 'Los accesos al parque requieren entrada oficial, que se compra antes de viajar. Dentro del parque el auto se deja solo en estacionamientos habilitados.',
  },
  {
    q: '¿Se puede reservar y pagar en línea?',
    a: 'No. Este sitio es un catálogo: la consulta y la reserva se hacen por WhatsApp, y el arriendo se formaliza con un contrato al retirar el vehículo.',
  },
];

// Las mismas preguntas, para los buscadores.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: preguntas.map((p) => ({
      '@type': 'Question',
      name: p.q,
      acceptedAnswer: { '@type': 'Answer', text: p.a },
    })),
  },
];

const pendientes = conditions.filter((c) => c.value === null).map((c) => c.label.toLowerCase());
---
<Base
  title="Condiciones, requisitos y preguntas frecuentes"
  description={`Requisitos para arrendar en ${site.name}: edad mínima ${site.minAge} años, licencia vigente, seguro incluido, kilometraje libre y precios con IVA incluido.`}
  schema={schema}
>
  <div class="contenedor encabezado-pagina">
    <h1 class="titular titular--pagina">Claro desde el principio</h1>
    <p class="bajada">
      Todo lo que conviene saber antes de escribirnos, en una página. Lo que todavía no
      está definido también está aquí, dicho como lo que es.
    </p>
  </div>

  <section class="seccion seccion--pegada" aria-labelledby="t-cuadro">
    <div class="contenedor">
      <div class="cabeza-seccion">
        <h2 id="t-cuadro" class="titular titular--seccion">El cuadro completo</h2>
      </div>
      <Condiciones />
      {
        pendientes.length > 0 && (
          <p class="letra-chica tras-bloque">
            Donde dice “Consúltanos” ({pendientes.join(', ')}) es porque todavía no tenemos
            el dato cerrado. Preferimos decirlo antes que publicar algo que después cambie:
            pregúntanos por WhatsApp y te lo respondemos.
          </p>
        )
      }
    </div>
  </section>

  <section class="seccion seccion--papel" aria-labelledby="t-requisitos">
    <div class="contenedor dos-columnas">
      <div>
        <div class="cabeza-seccion">
          <h2 id="t-requisitos" class="titular titular--seccion">Qué tienes que traer</h2>
        </div>
        <ul class="tildes">
          {
            requirements.map((r) => (
              <li>
                <Icono name="tilde" size={20} />
                <span>{r}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <div class="cabeza-seccion">
          <h2 class="titular titular--seccion">Qué va incluido</h2>
        </div>
        <ul class="tildes">
          {
            services.map((s) => (
              <li>
                <Icono name="tilde" size={20} />
                <span>{s}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="seccion seccion--papel seccion--pegada" aria-labelledby="t-preguntas">
    <div class="contenedor">
      <div class="cabeza-seccion">
        <h2 id="t-preguntas" class="titular titular--seccion">Preguntas frecuentes</h2>
      </div>
      <div class="preguntas">
        {
          preguntas.map((p) => (
            <details>
              <summary>{p.q}</summary>
              <p>{p.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Cierre
    titulo="¿Te quedó una duda?"
    texto="Pregúntanos por WhatsApp. Si no tenemos el dato, te lo decimos."
    mensaje="Hola, vengo de patagonesrentacar.cl y tengo una pregunta sobre las condiciones de arriendo."
  />
</Base>

<style>
  .dos-columnas {
    display: grid;
    gap: var(--e7);
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  }
</style>
