---
import Base from '../layouts/Base.astro';
import Consulta from '../components/Consulta.astro';
import Icono from '../components/Icono.astro';
import { site } from '../data/site';
import { waLink } from '../lib/format';
---
<Base
  title="Contacto y reservas"
  description={`Consulta disponibilidad por WhatsApp al ${site.phoneDisplay}. Atención ${site.hours.toLowerCase()} en ${site.city}, Patagonia chilena.`}
>
  <div class="contenedor encabezado-pagina">
    <h1 class="titular titular--pagina">Hablemos por WhatsApp</h1>
    <p class="bajada">
      Es la vía más rápida y la única que usamos para reservar. Elige auto y fechas y te
      respondemos con la disponibilidad y el precio final.
    </p>
  </div>

  <section class="seccion seccion--pegada">
    <div class="contenedor contacto-reja">
      <div class="pila">
        <h2 class="titular titular--bloque">Consulta con tus fechas</h2>
        <Consulta id="contacto" />
      </div>

      <div class="contacto">
        <div>
          <h2>WhatsApp</h2>
          <p class="contacto__dato">{site.phoneDisplay}</p>
          <p>La vía que usamos para reservar.</p>
          <!-- Botón de línea y no naranja: el naranja es la acción principal de
               la página, y esa es el formulario de al lado. Dos botones
               naranjas en la misma pantalla compiten entre sí. -->
          <a class="boton boton--linea" href={waLink()} rel="noopener">
            <Icono name="wasap" size={18} />
            Escribir ahora
          </a>
        </div>

        <div>
          <h2>Teléfono</h2>
          <p class="contacto__dato">
            <a class="enlace" href={site.phoneHref}>{site.phoneDisplay}</a>
          </p>
          <p>El mismo número, si prefieres llamar.</p>
        </div>

        <div>
          <h2>Horario</h2>
          <p class="contacto__dato">8:00 a 21:00</p>
          <p>Todos los días. Asistencia en ruta 24/7.</p>
        </div>

        <div>
          <h2>Dónde estamos</h2>
          <p class="contacto__dato">{site.city}</p>
          <p>
            {site.region}, {site.country}. Te entregamos el auto en el aeropuerto o en tu
            hotel. Existe otro Patagones Rent a Car en Bariloche, Argentina, que no tiene
            relación con nosotros.
          </p>
        </div>

        {
          site.email && (
            <div>
              <h2>Correo</h2>
              <p class="contacto__dato">
                <a class="enlace" href={`mailto:${site.email}`}>{site.email}</a>
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .contacto-reja {
    display: grid;
    gap: var(--e7);
    align-items: start;
  }

  @media (min-width: 980px) {
    .contacto-reja {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* En contacto las tarjetas van una bajo otra, no en reja: son datos de
     lectura, no opciones que se comparen. */
  .contacto-reja .contacto {
    grid-template-columns: 1fr;
  }
</style>
