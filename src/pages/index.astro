---
import Base from '../layouts/Base.astro';
import ConsultForm from '../components/ConsultForm.astro';
import Conditions from '../components/Conditions.astro';
import CarCard from '../components/CarCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Mountains from '../components/Mountains.astro';
import { site } from '../data/site';
import { fleet, minPrice } from '../data/fleet';
import { parkRoutes } from '../data/routes';
import { clp } from '../lib/format';
---
<Base
  title="Arriendo de autos en Puerto Natales y Torres del Paine | Patagones Rent a Car"
  description={`SUV automáticas con seguro y kilometraje libre en Puerto Natales, desde ${clp(minPrice)} por día con IVA incluido. Entrega en el aeropuerto o en tu hotel. Consulta por WhatsApp.`}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Puerto Natales · Patagonia chilena</p>
        <h1 class="display display-xl">Tu auto listo para Torres del Paine.</h1>
        <p class="lead">
          {site.slogan} SUV automáticas con seguro y kilometraje libre, entregadas en el
          aeropuerto o en tu hotel.
        </p>
        <ConsultForm />
        <p class="hero-meta">{site.hours} · Desde {clp(minPrice)} por día, IVA incluido.</p>
      </div>
      <div class="hero-art">
        <Mountains />
      </div>
    </div>
  </section>

  <section class="section section-light" aria-labelledby="condiciones-titulo">
    <div class="container">
      <div class="section-head">
        <h2 id="condiciones-titulo" class="display display-l">Las condiciones, antes de que preguntes.</h2>
      </div>
      <Conditions />
      <p class="fine-print"><a href="/condiciones/">Ver requisitos y preguntas frecuentes</a></p>
    </div>
  </section>

  <section class="section section-light" style="padding-top: 0" aria-labelledby="flota-titulo">
    <div class="container">
      <div class="section-head">
        <h2 id="flota-titulo" class="display display-l">Nuestra flota</h2>
        <p>Cuatro SUV automáticas. Entrega con estanque lleno y revisión previa al viaje.</p>
      </div>
      <div class="fleet-grid">
        {fleet.map((car) => <CarCard car={car} />)}
      </div>
      <p class="fine-print">Precios por día con IVA incluido. La tarifa se ajusta desde dos días de arriendo.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="rutas-titulo">
    <div class="container">
      <div class="section-head">
        <h2 id="rutas-titulo" class="display display-l">Rutas en Torres del Paine</h2>
        <p>El parque queda a poco más de dos horas de Puerto Natales. Elige el auto según tu ruta.</p>
      </div>
      <div class="routes-grid">
        {
          parkRoutes.map((route) => (
            <article class="route-card">
              <h3>{route.name}</h3>
              <p class="route-meta">{route.duration}</p>
              <p class="route-reco">Recomendado: {route.recommended}</p>
            </article>
          ))
        }
      </div>
      <p class="fine-print" style="color: var(--muted)">
        <a href="/torres-del-paine/">Ver la guía de rutas</a>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="pasos-titulo">
    <div class="container" style="padding-top: 56px; border-top: 1px solid var(--line)">
      <div class="section-head">
        <h2 id="pasos-titulo" class="display display-l">Reserva en tres pasos</h2>
      </div>
      <ol class="steps">
        <li><strong>Elige auto y fechas</strong><span>Ves el precio por día y las condiciones en la misma página.</span></li>
        <li><strong>Confirmamos por WhatsApp</strong><span>Te enviamos la disponibilidad y el precio final.</span></li>
        <li><strong>Recibe el auto</strong><span>En el aeropuerto o en tu hotel, con el estanque lleno.</span></li>
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>
