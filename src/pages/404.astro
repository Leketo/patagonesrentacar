---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada" description="La página que buscas no existe." noindex>
  <div class="container page-head" style="padding-block: 80px 120px">
    <p class="eyebrow">Error 404</p>
    <h1 class="display display-xl">Este camino no lleva a ningún lado.</h1>
    <p class="lead">La página que buscas no existe o cambió de dirección.</p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px">
      <a class="btn btn-accent" href="/">Volver al inicio</a>
      <a class="btn btn-outline" href="/flota/">Ver la flota</a>
    </div>
  </div>
</Base>
